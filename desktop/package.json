{
  "name": "frontiers-end",
  "productName": "Frontier's End",
  "version": "0.9.0",
  "description": "Frontier's End — 2D open-world western survival and life simulation.",
  "main": "main.js",
  "private": true,
  "steamAppId": 480,
  "scripts": {
    "prepare-app": "node scripts/prepare.js",
    "start": "npm run prepare-app && electron .",
    "dev": "npm run prepare-app && electron . --dev",
    "dist:win": "npm run prepare-app && electron-builder --win --x64",
    "dist:linux": "npm run prepare-app && electron-builder --linux --x64",
    "dist:mac": "npm run prepare-app && electron-builder --mac --universal",
    "achievements": "node scripts/achievements.js"
  },
  "dependencies": {
    "steamworks.js": "^0.4.0"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.frontiersend.game",
    "productName": "Frontier's End",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "package.json", "app/**/*"],
    "asarUnpack": ["node_modules/steamworks.js/**/*"],
    "win": { "target": "dir", "icon": "build/icon.png" },
    "linux": { "target": "dir", "icon": "build/icon.png", "category": "Game" },
    "mac": { "target": "dir", "icon": "build/icon.png", "category": "public.app-category.role-playing-games" }
  }
}
